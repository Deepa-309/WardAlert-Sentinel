{
  "name": "wardalert-sentinel",
  "version": "1.0.0",
  "description": "WardAlert Sentinel - Smart Alert-Fatigue Analyzer (Final-Year Academic Prototype / MVP)",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "ts-node simulation/seed.ts",
    "seed": "npm run db:push && npm run db:seed",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "ts-node tests/run_all_tests.ts",
    "test:unit": "ts-node tests/run_unit_tests.ts",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
